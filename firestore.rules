rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function claimedRole() {
      return signedIn() ? request.auth.token.get('role', 'jamaah') : 'anonymous';
    }

    function isAdmin() {
      return claimedRole() == 'admin';
    }

    function isClaimedPendamping() {
      return claimedRole() == 'pendamping';
    }

    function isRoomMember(roomId) {
      return signedIn() && exists(
        /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)
      );
    }

    function isRoomManager(roomId) {
      return isClaimedPendamping() && isRoomMember(roomId) &&
        get(
          /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)
        ).data.role == 'pendamping';
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      // Profiles are provisioned by ensureUserProfile. Clients may only edit
      // non-authoritative personal/medical/location fields.
      allow create: if false;
      allow update: if isSelf(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'allergies', 'bloodType', 'conditions', 'currentLocation',
          'displayName', 'emergencyContact', 'isGpsActive',
          'locationUpdatedAt', 'name', 'photoUrl', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if isAdmin() || isRoomMember(roomId);
      allow write: if false;

      match /members/{memberUid} {
        allow read: if isAdmin() || isRoomMember(roomId);
        allow create, delete: if false;
        allow update: if isSelf(memberUid) && isRoomMember(roomId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'currentLocation', 'isGpsActive', 'locationUpdatedAt'
          ]);
      }
    }

    match /invitations/{invitationId} {
      allow read: if isAdmin() || (signedIn() && (
        resource.data.toUserId == request.auth.uid ||
        resource.data.fromUserId == request.auth.uid
      ));
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() &&
        resource.data.recipientId == request.auth.uid);
      allow create, delete: if false;
      allow update: if signedIn() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

    match /sos_events/{eventId} {
      allow read: if isAdmin() || (signedIn() && (
        resource.data.userId == request.auth.uid ||
        isRoomMember(resource.data.roomId)
      ));
      allow write: if false;
    }

    match /activities/{activityId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Server-only coordination collections. Admin SDK bypasses Security Rules.
    match /roomCodes/{code} {
      allow read, write: if false;
    }

    match /active_sos/{uid} {
      allow read, write: if false;
    }

    match /pairings/{pairingId} {
      allow read: if isAdmin() || isSelf(pairingId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
