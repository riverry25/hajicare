rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData(request.auth.uid).role == 'admin';
    }

    function isPendamping() {
      return isAuthenticated() && getUserData(request.auth.uid).role == 'pendamping';
    }

    function isMemberOfRoom(roomId) {
      return isAuthenticated() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
      );
    }

    // ── USERS COLLECTION ─────────────────────────────────────────────────────
    match /users/{uid} {
      // Authenticated users can read profiles for monitoring/member list
      allow read: if isAuthenticated();

      // Users can create their own profile on registration
      allow create: if isUser(uid);

      // Users can update their profile fields (distance, SOS, name, etc.)
      // Prevent ordinary users from altering their own role.
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isUser(uid) &&
          request.resource.data.role == resource.data.role
        ) ||
        // Allow pendamping to assign/unassign activeRoomId and reset sosActive for a jamaah
        (
          isPendamping() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeRoomId', 'sosActive'])
        )
      );

      allow delete: if isAdmin();
    }

    // ── ROOMS COLLECTION ─────────────────────────────────────────────────────
    match /rooms/{roomId} {
      // Any authenticated user can read room metadata for validation / join
      allow read: if isAuthenticated();

      // Admin or Pendamping can create room
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          isPendamping() &&
          request.resource.data.name is string &&
          request.resource.data.code is string
        )
      );

      // Admin can update anything, Pendamping can only update room if they are the creator
      // and cannot modify ownership/identity fields (createdBy, createdByRole, pendampingId, code, createdAt)
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isPendamping() &&
          request.auth.uid == resource.data.createdBy &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.createdByRole == resource.data.createdByRole &&
          request.resource.data.pendampingId == resource.data.pendampingId &&
          request.resource.data.code == resource.data.code &&
          request.resource.data.createdAt == resource.data.createdAt
        )
      );

      // Admin or the Pendamping creator can delete room
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (
          isPendamping() &&
          request.auth.uid == resource.data.createdBy
        )
      );

      // ── ROOM MEMBERS SUBCOLLECTION ──────────────────────────────────────────
      match /members/{memberUid} {
        // Members of the room and admins can read member listings
        allow read: if isMemberOfRoom(roomId);

        // Membership creation:
        // 1. Admin
        // 2. Self-join: authenticated user adding themselves to an active, existing room
        // 3. Pendamping of this room adding an unassigned jamaah
        allow create: if isAuthenticated() && (
          isAdmin() ||
          (
            isUser(memberUid) &&
            exists(/databases/$(database)/documents/rooms/$(roomId)) &&
            get(/databases/$(database)/documents/rooms/$(roomId)).data.isActive == true &&
            request.resource.data.role in ['pendamping', 'jamaah']
          ) ||
          (
            isPendamping() &&
            isMemberOfRoom(roomId) &&
            exists(/databases/$(database)/documents/rooms/$(roomId)) &&
            get(/databases/$(database)/documents/rooms/$(roomId)).data.isActive == true &&
            request.resource.data.role == 'jamaah'
          )
        );

        // Member update: Admin or the member updating only currentLocation and locationUpdatedAt
        allow update: if isAuthenticated() && (
          isAdmin() ||
          (
            isUser(memberUid) &&
            isMemberOfRoom(roomId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentLocation', 'locationUpdatedAt'])
          )
        );

        // Member deletion:
        // 1. Admin
        // 2. Self-leave (user leaving their own room)
        // 3. Pendamping of this room removing a member
        allow delete: if isAuthenticated() && (
          isAdmin() ||
          isUser(memberUid) ||
          (
            isPendamping() &&
            (
              get(/databases/$(database)/documents/rooms/$(roomId)).data.pendampingId == request.auth.uid ||
              exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
            )
          )
        );
      }
    }

    // ── INVITATIONS COLLECTION ────────────────────────────────────────────────
    match /invitations/{invitationId} {
      allow read: if isAuthenticated();
      // Pendamping or Admin can send invitation
      allow create: if isAuthenticated() && (isAdmin() || isPendamping());
      // Recipient can update status (accept/reject), or creator/admin
      // When accepting, target room must exist and be active
      allow update: if isAuthenticated() && (
        request.resource.data.status != 'accepted' || (
          exists(/databases/$(database)/documents/rooms/$(resource.data.roomId)) &&
          get(/databases/$(database)/documents/rooms/$(resource.data.roomId)).data.isActive == true
        )
      );
      allow delete: if isAdmin();
    }

    // ── NOTIFICATIONS COLLECTION ──────────────────────────────────────────────
    match /notifications/{notificationId} {
      // User can read notifications addressed to them, or admin
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.recipientId == request.auth.uid
      );

      // Create:
      // - Admin: can create any notification
      // - Pendamping: can create notifications if they are sender
      // - Authenticated users for SOS alerts or room invitations
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          isPendamping() &&
          request.resource.data.senderId == request.auth.uid
        ) ||
        (
          request.resource.data.type in ['sos_alert', 'room_invitation', 'room_deleted', 'room_removed']
        )
      );

      // Recipient can update isRead, or admin
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          resource.data.recipientId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        )
      );

      allow delete: if isAdmin();
    }

    // ── SOS EVENTS ───────────────────────────────────────────────────────────
    match /sos_events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Admin and Pendamping can update SOS status (direspons, selesai, eskalasi)
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── LEGACY PAIRINGS (Graceful transition) ─────────────────────────────────
    match /pairings/{pairingId} {
      allow read, write: if isAuthenticated();
    }
  }
}
