rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function claimedRole() {
      return signedIn() ? request.auth.token.get('role', 'jamaah') : 'anonymous';
    }

    function isAdmin() {
      // Custom claim is preferred. The users/{uid}.role fallback mirrors the
      // client (HajiCareController) and is safe because clients can never
      // create or update their own role to 'admin' (see /users rules).
      return claimedRole() == 'admin' || (
        signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
      );
    }

    function isClaimedPendamping() {
      return claimedRole() == 'pendamping';
    }

    function isRoomMember(roomId) {
      return signedIn() && roomId != null && roomId != '' && exists(
        /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)
      );
    }

    function isRoomManager(roomId) {
      return isRoomMember(roomId) && (
        isClaimedPendamping() ||
        get(
          /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)
        ).data.role in ['pendamping', 'petugas'] ||
        (
          exists(/databases/$(database)/documents/rooms/$(roomId)) && (
            get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid ||
            get(/databases/$(database)/documents/rooms/$(roomId)).data.get('coOwnerId', '') == request.auth.uid
          )
        )
      );
    }

    function isValidCompanionMessage() {
      let data = request.resource.data;
      let roomId = data.get('targetRoomId', '');
      let recipientId = data.get('recipientId', '');
      return signedIn() &&
        data.get('type', '') in ['companion_info', 'companion_message'] &&
        roomId is string && roomId.size() > 0 &&
        recipientId is string && recipientId.size() > 0 &&
        data.get('senderId', '') == request.auth.uid &&
        data.get('senderRole', '') in ['jamaah', 'pendamping'] &&
        data.get('targetUserId', '') == recipientId &&
        data.get('scope', '') in ['user', 'all_companions'] &&
        data.get('title', '') is string &&
        data.get('title', '').size() > 0 &&
        data.get('title', '').size() <= 100 &&
        data.get('message', '') is string &&
        data.get('message', '').size() > 0 &&
        data.get('message', '').size() <= 500 &&
        data.get('isRead', true) == false &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.isActive == true &&
        isRoomMember(roomId) &&
        exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(recipientId));
    }

    match /users/{uid} {
      // Pembacaan akun pengguna diizinkan untuk semua pengguna terotentikasi (signedIn),
      // agar pencarian email jamaah untuk undangan rombongan dan pemindaian pendamping dapat berjalan.
      allow read: if signedIn();

      // 2. Registrasi mandiri: pengguna dapat memilih mendaftar sebagai 'jamaah'
      // atau 'pendamping' (atau 'petugas'). Peran 'admin' TIDAK PERNAH bisa dibuat oleh client.
      allow create: if isSelf(uid) &&
        request.resource.data.get('role', 'jamaah') in ['jamaah', 'pendamping', 'petugas'] &&
        request.resource.data.get('name', '').size() <= 100 &&
        request.resource.data.get('nik', '').size() <= 30;

      // 3. Update profil: Pengguna memperbarui profil miliknya sendiri (nama, kontak darurat,
      // GPS pribadi, status SOS, rekam medis).
      // PERINGATAN KEAMANAN: 'role' TIDAK DAPAT diubah melalui update guna mencegah eskalasi wewenang (privilege escalation).
      allow update: if isSelf(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'allergies', 'bloodType', 'conditions', 'currentLocation',
          'displayName', 'emergencyContact', 'isGpsActive',
          'locationUpdatedAt', 'name', 'nomorPorsi', 'porsi', 'photoUrl', 'updatedAt',
          'email', 'normalizedEmail', 'activeRoomId', 'sosActive', 'sosTime',
          'phone', 'phoneNumber', 'nik', 'maktab', 'kloter'
        ]) &&
        request.resource.data.get('displayName', '').size() <= 100 &&
        request.resource.data.get('emergencyContact', '').size() <= 50 &&
        request.resource.data.get('allergies', '').size() <= 500 &&
        request.resource.data.get('conditions', '').size() <= 500;

      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn();

      // Update rombongan:
      // A. Admin atau Owner Utama dapat mengubah semua pengaturan termasuk createdBy dan coOwnerId.
      // B. Owner Kedua / Pengelola rombongan dapat mengubah pengaturan operasional (nama, maktab, safeRadius, pendampingIds),
      //    namun DILARANG mengubah createdBy atau coOwnerId.
      // C. Anggota bergabung via direct-join HANYA dapat memperbarui memberCount dan updatedAt (dilarang memanipulasi pendampingIds).
      allow update: if signedIn() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        (
          isRoomManager(roomId) &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.get('coOwnerId', null) == resource.data.get('coOwnerId', null)
        ) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberCount', 'updatedAt'
        ])
      );

      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);

      match /members/{memberUid} {
        // Hanya sesama anggota rombongan atau admin yang dapat membaca daftar anggota rombongan
        allow read: if signedIn() && (isAdmin() || isRoomMember(roomId));

        // Pengguna mendaftarkan dirinya sendiri ke rombongan sesuai perannya (jamaah atau pendamping).
        // Peran 'admin' dilarang. Dilarang bergabung ke rombongan yang nonaktif atau sedang dihapus.
        allow create: if isSelf(memberUid) &&
          request.resource.data.get('role', 'jamaah') in ['jamaah', 'pendamping', 'petugas'] &&
          get(/databases/$(database)/documents/rooms/$(roomId)).data.get('isActive', true) == true &&
          get(/databases/$(database)/documents/rooms/$(roomId)).data.get('status', 'active') != 'deleting';

        // Pengguna memperbarui status runtime miliknya sendiri (lokasi GPS, status SOS, waktu aktif).
        // Dilarang mengubah 'role' anggota untuk mencegah eskalasi peran di dalam rombongan.
        allow update: if isSelf(memberUid) &&
          request.resource.data.get('role', resource.data.get('role', 'jamaah')) == resource.data.get('role', 'jamaah') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'currentLocation', 'locationUpdatedAt', 'isGpsActive', 'sosActive', 'sosTime',
            'updatedAt', 'lastActiveAt', 'displayName', 'name'
          ]);

        allow delete: if isSelf(memberUid) || isAdmin() || isRoomManager(roomId);
      }
    }

    match /invitations/{invitationId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.toUserId == request.auth.uid ||
        resource.data.fromUserId == request.auth.uid
      );

      // Pengirim undangan harus sesuai dengan pengguna yang login
      allow create: if signedIn() &&
        request.resource.data.fromUserId == request.auth.uid;

      // Penerima dan pengirim hanya dapat memperbarui status respon undangan
      allow update: if signedIn() && (
        isAdmin() || (
          (resource.data.toUserId == request.auth.uid || resource.data.fromUserId == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'respondedAt'])
        )
      );

      allow delete: if signedIn() && (
        isAdmin() ||
        resource.data.fromUserId == request.auth.uid
      );
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      );

      // Pesan antar anggota rombongan divalidasi ketat (isValidCompanionMessage),
      // sedangkan notifikasi langsung lainnya memvalidasi senderId dan batas ukuran teks.
      allow create: if signedIn() && (
        (
          request.resource.data.get('type', '') != 'pickup_request' &&
          request.resource.data.get('type', '') != 'companion_info' &&
          request.resource.data.get('type', '') != 'companion_message' &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.title is string &&
          request.resource.data.title.size() <= 100 &&
          request.resource.data.message is string &&
          request.resource.data.message.size() <= 500
        ) || isValidCompanionMessage()
      );

      allow update: if signedIn() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);

      allow delete: if signedIn() && (
        isAdmin() ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      );
    }

    match /sos_events/{eventId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.userId == request.auth.uid ||
          (resource.data.get('roomId', null) != null && isRoomMember(resource.data.roomId))
        )
      );

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.jamaahId == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.get('userName', '').size() <= 100 &&
        (
          request.resource.data.get('roomId', null) == null ||
          request.resource.data.roomId == '' ||
          (
            request.resource.data.roomId is string &&
            isRoomMember(request.resource.data.roomId)
          )
        );

      allow update: if signedIn() && (
        // Kasus 1: Jamaah korban memperbarui lokasi GPS live pada event SOS aktif miliknya
        (
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'active' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'location', 'locationUpdatedAt'
          ])
        ) ||
        // Kasus 2: Transisi status penanganan ('direspons', 'selesai', 'cancelled')
        (
          (
            isAdmin() ||
            resource.data.userId == request.auth.uid ||
            (resource.data.get('roomId', null) != null && isRoomManager(resource.data.roomId))
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'respondedAt', 'respondedBy', 'respondedByName',
            'resolvedAt', 'resolvedBy', 'cancelledAt', 'cancelledBy', 'status'
          ]) &&
          request.resource.data.status in ['direspons', 'selesai', 'cancelled'] && (
            (
              request.resource.data.status == 'direspons' &&
              request.resource.data.respondedBy == request.auth.uid &&
              request.resource.data.respondedByName is string
            ) || (
              request.resource.data.status == 'selesai' &&
              request.resource.data.resolvedBy == request.auth.uid
            ) || (
              request.resource.data.status == 'cancelled' &&
              request.resource.data.cancelledBy == request.auth.uid
            )
          )
        )
      );

      allow delete: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if isAdmin();
      // Mengizinkan pencatatan log aktivitas dari aksi pengguna sendiri (append-only)
      // Menjamin batch write transaksi SOS dan join rombongan tidak gagal
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.type is string;
      allow update, delete: if false;
    }

    // Pemetaan kode rombongan (room codes)
    match /roomCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.roomId is string &&
        request.resource.data.roomId.size() > 0;
      allow update: if false;
      allow delete: if isAdmin() || (
        signedIn() &&
        exists(/databases/$(database)/documents/rooms/$(resource.data.roomId)) &&
        get(/databases/$(database)/documents/rooms/$(resource.data.roomId)).data.createdBy == request.auth.uid
      );
    }

    match /active_sos/{uid} {
      allow read, write: if false;
    }

    match /pairings/{pairingId} {
      allow read: if isAdmin() || isSelf(pairingId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
