rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function claimedRole() {
      return signedIn() ? request.auth.token.get('role', 'jamaah') : 'anonymous';
    }

    function isAdmin() {
      return claimedRole() == 'admin';
    }

    function isClaimedPendamping() {
      return claimedRole() == 'pendamping';
    }

    function isRoomMember(roomId) {
      return signedIn() && exists(
        /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)
      );
    }

    function isRoomManager(roomId) {
      return isClaimedPendamping() && isRoomMember(roomId) &&
        get(
          /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)
        ).data.role == 'pendamping';
    }

    function isValidCompanionMessage() {
      let data = request.resource.data;
      let roomId = data.get('targetRoomId', '');
      let recipientId = data.get('recipientId', '');
      return signedIn() &&
        data.get('type', '') in ['companion_info', 'companion_message'] &&
        roomId is string && roomId.size() > 0 &&
        recipientId is string && recipientId.size() > 0 &&
        data.get('senderId', '') == request.auth.uid &&
        data.get('senderRole', '') == 'jamaah' &&
        data.get('targetUserId', '') == recipientId &&
        data.get('scope', '') in ['user', 'all_companions'] &&
        data.get('title', '') is string &&
        data.get('title', '').size() > 0 &&
        data.get('title', '').size() <= 80 &&
        data.get('message', '') is string &&
        data.get('message', '').size() > 0 &&
        data.get('message', '').size() <= 500 &&
        data.get('isRead', true) == false &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.isActive == true &&
        get(
          /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)
        ).data.role == 'jamaah' &&
        get(
          /databases/$(database)/documents/rooms/$(roomId)/members/$(recipientId)
        ).data.role == 'pendamping';
    }

    match /users/{uid} {
      allow read: if signedIn();

      // Self-registration: client may create its own profile only during
      // initial sign-up and with role 'jamaah', 'pendamping', or 'petugas'.
      // Admin role can NEVER be created by client.
      allow create: if isSelf(uid) &&
        request.resource.data.get('role', 'jamaah') in ['jamaah', 'pendamping', 'petugas'];

      // Clients may edit personal/medical/location fields, but never escalate to admin.
      allow update: if isSelf(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'allergies', 'bloodType', 'conditions', 'currentLocation',
          'displayName', 'emergencyContact', 'isGpsActive',
          'locationUpdatedAt', 'name', 'nomorPorsi', 'porsi', 'photoUrl', 'updatedAt',
          'email', 'normalizedEmail', 'role', 'activeRoomId', 'sosActive', 'sosTime'
        ]) &&
        request.resource.data.get('role', resource.data.get('role', 'jamaah')) != 'admin';
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);

      match /members/{memberUid} {
        allow read: if signedIn();
        allow create, update: if isSelf(memberUid);
        allow delete: if isSelf(memberUid) || isAdmin() || isRoomManager(roomId);
      }
    }

    match /invitations/{invitationId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.toUserId == request.auth.uid ||
        resource.data.fromUserId == request.auth.uid
      );
      allow create: if signedIn();
      allow update: if signedIn() && (
        isAdmin() ||
        resource.data.toUserId == request.auth.uid ||
        resource.data.fromUserId == request.auth.uid
      );
      allow delete: if signedIn() && (
        isAdmin() ||
        resource.data.fromUserId == request.auth.uid
      );
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      );
      // Companion messages prefer a trusted callable. A strictly validated
      // direct write keeps delivery working while that callable is unavailable.
      allow create: if signedIn() && (
        (
          request.resource.data.get('type', '') != 'pickup_request' &&
          request.resource.data.get('type', '') != 'companion_info' &&
          request.resource.data.get('type', '') != 'companion_message'
        ) || isValidCompanionMessage()
      );
      allow update: if signedIn() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if signedIn() && (
        isAdmin() ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      );
    }

    match /sos_events/{eventId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.userId == request.auth.uid ||
          (resource.data.get('roomId', null) != null && isRoomMember(resource.data.roomId))
        )
      );

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.jamaahId == request.auth.uid &&
        request.resource.data.status == 'active' &&
        (
          request.resource.data.get('roomId', null) == null ||
          request.resource.data.roomId == '' ||
          (
            request.resource.data.roomId is string &&
            isRoomMember(request.resource.data.roomId)
          )
        );

      allow update: if isAdmin() || (
        signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          (resource.data.get('roomId', null) != null && isRoomManager(resource.data.roomId))
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'respondedAt', 'respondedBy', 'respondedByName',
          'resolvedAt', 'resolvedBy', 'cancelledAt', 'cancelledBy', 'status'
        ]) &&
        request.resource.data.status in ['direspons', 'selesai', 'cancelled'] && (
          (
            request.resource.data.status == 'direspons' &&
            request.resource.data.respondedBy == request.auth.uid &&
            request.resource.data.respondedByName is string
          ) || (
            request.resource.data.status == 'selesai' &&
            request.resource.data.resolvedBy == request.auth.uid
          ) || (
            request.resource.data.status == 'cancelled' &&
            request.resource.data.cancelledBy == request.auth.uid
          )
        )
      );

      allow delete: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Room codes collection: allows signed-in users to lookup/create room mapping
    match /roomCodes/{code} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn();
    }

    match /active_sos/{uid} {
      allow read, write: if false;
    }

    match /pairings/{pairingId} {
      allow read: if isAdmin() || isSelf(pairingId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
