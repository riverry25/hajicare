rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profil avatar / foto jamaah: hanya pemilik akun yang dapat mengunggah file miliknya sendiri
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Media lampiran rombongan (foto dokumentasi / panduan jamaah)
    match /rooms/{roomId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Default deny untuk seluruh direktori lain
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
